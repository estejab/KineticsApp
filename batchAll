        // Calculate Production Rate RA = dCA/dt
        function calculateProductionRateA(CA, CB, k1, k2) {
            if (rxnType === '1_irrev') return -k1 * CA;
            if (rxnType === '1_rev') return -k1 * CA + k2 * CB;
            if (rxnType === '2_irrev') return -k1 * CA * CA;
            if (rxnType === 'n_order') return -k1 * Math.pow(Math.max(0, CA), nOrder);
            if (rxnType === 'series') return -k1 * CA;
            if (rxnType === 'parallel') return -(k1 + k2) * CA;
            return 0;
        }

